# --- deploy (scripts/deploy.js) ---
# Funded with test ETH on Sepolia / Base Sepolia / Arbitrum Sepolia / OP Sepolia and test QMS on QMS Testnet
DEPLOYER_KEY=0x...
# Address that owns the contracts (pause, limits, set relayer). Defaults to the deployer.
# OWNER_ADDRESS=0x...
# The relayer's PUBLIC address (a separate key from the deployer is recommended)
RELAYER_ADDRESS=0x...
# WQMS (wrapped native QMS, WETH9-style) on QMS Testnet. Use the one QWAP uses.
WQMS_ADDRESS=0x...
# Optional: only (re)deploy some chains, e.g. ONLY_CHAINS=84532,421614
# ONLY_CHAINS=

# --- relayer (relayer/run.js) ---
# Needs gas on every chain: test QMS on QMS Testnet, test ETH on each remote chain
RELAYER_KEY=0x...
# CONFIRMATIONS=3
# POLL_MS=8000
# MAX_LOG_RANGE=1000

# --- optional RPC overrides ---
# RPC_19480=https://rpc.testnet.qms.finance
# RPC_11155111=
# RPC_84532=
# RPC_421614=
# RPC_11155420=
